# ~/.config/mako/config — generated by hypr-rice
# palette: tokyo-night    daemon: mako    anchor: top-right
# mako urgency criteria values are low|normal|critical (NO "high" — silently no-ops).

font=Inter 11
width=340
height=120
margin=10
padding=14
border-size=2
border-radius=10
anchor=top-right
layer=overlay
max-visible=5
icons=1
max-icon-size=48
markup=1
format=<b>%s</b>\n%b
default-timeout=5000
ignore-timeout=1
group-by=app-name

# --- colors (tokyo-night, inlined — mako has no include/import directive) ---
background-color=#24283bee
text-color=#c0caf5
border-color=#7aa2f7
progress-color=over #7aa2f744

[urgency=low]
border-color=#565f89

[urgency=critical]
border-color=#f7768e
default-timeout=0

[grouped]
format=<b>%s</b>\n%b\n<small>(%g)</small>

[mode=do-not-disturb]
invisible=1
