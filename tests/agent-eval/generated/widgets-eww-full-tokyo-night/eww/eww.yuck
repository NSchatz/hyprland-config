;; -----------------------------------------------------------------------------
;; eww — Hyprland widget set (runs ALONGSIDE waybar; widgets.system = eww)
;;
;; Enabled widgets (from widgets.enabled):
;;   osd, music, calendar, power-menu, sysinfo
;;
;; Layer namespaces are set explicitly on every defwindow so the Hyprland
;; layerrule (`match:namespace = eww-*`) can target them for blur.
;; Heights/widths are concrete (NO `:height "auto"` — eww errors on that).
;; Styling lives in eww.scss; colors come from the engine-rendered colors.scss.
;; -----------------------------------------------------------------------------

;; -- Pollers / listeners -------------------------------------------------------
(defpoll clock-time  :interval "10s" "date '+%H:%M'")
(defpoll clock-date  :interval "60s" "date '+%A, %B %-d'")

(defpoll cpu-usage   :interval "2s"
  "LC_ALL=C top -bn1 | awk '/Cpu\\(s\\):/ {print 100 - $8; exit}'")
(defpoll mem-usage   :interval "5s"
  "free | awk '/Mem:/ {printf \"%.0f\", ($3/$2)*100}'")
(defpoll disk-usage  :interval "30s"
  "df -P / | awk 'NR==2 {sub(/%/, \"\", $5); print $5}'")
(defpoll temp-value  :interval "5s"
  "sensors 2>/dev/null | awk '/Package id 0:|Tctl:/ {gsub(/[+°C]/, \"\", $2); print int($2); exit} END {if (NR==0) print 0}'")

(defpoll vol-level   :interval "1s"
  "wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print int($2 * 100)}'")
(defpoll vol-icon    :interval "1s"
  "wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -q MUTED && echo '󰝟' || echo '󰕾'")

(deflisten player    :initial "{}"
  "playerctl --follow metadata --format '{\"status\":\"{{status}}\",\"title\":\"{{title}}\",\"artist\":\"{{artist}}\",\"art\":\"{{mpris:artUrl}}\"}' 2>/dev/null")
(defpoll  player-pos :interval "1s"
  "playerctl position 2>/dev/null || echo 0")
(defpoll  player-len :interval "5s"
  "playerctl metadata mpris:length 2>/dev/null | awk '{print $1/1000000}'")

;; -- Widget: OSD ---------------------------------------------------------------
(defwidget osd-bar [icon label value]
  (box :class "osd" :orientation "h" :space-evenly false
    (label :class "osd-icon" :text icon)
    (box :orientation "v" :space-evenly false
      (label :class "osd-label" :text label :halign "start")
      (scale :value value :min 0 :max 100 :active false))))

(defwindow osd
  :monitor 0
  :stacking "overlay"
  :focusable "none"
  :namespace "eww-osd"
  :geometry (geometry :x "0" :y "60px" :width "320px" :height "60px"
                      :anchor "top center")
  (osd-bar :icon vol-icon :label "Volume" :value vol-level))

;; -- Widget: Music card --------------------------------------------------------
(defwidget music-card []
  (box :class "music" :orientation "h" :space-evenly false
    (image :class "music-cover"
           :path {player.art ?: "/dev/null"}
           :image-width 84 :image-height 84)
    (box :orientation "v" :space-evenly false :hexpand true
      (label :class "music-title"  :text {player.title  ?: "—"}
             :limit-width 28 :halign "start")
      (label :class "music-artist" :text {player.artist ?: ""}
             :limit-width 28 :halign "start")
      (box :class "music-controls" :orientation "h" :halign "start" :space-evenly false
        (button :onclick "playerctl previous" "")
        (button :class "play" :onclick "playerctl play-pause"
                {player.status == "Playing" ? "" : ""})
        (button :onclick "playerctl next" ""))
      (box :class "music-seek" :orientation "h"
        (scale :value player-pos
               :min 0
               :max {player-len > 0 ? player-len : 1}
               :onchange "playerctl position {}"
               :active true)))))

(defwindow music
  :monitor 0
  :stacking "fg"
  :focusable "ondemand"
  :namespace "eww-music"
  :geometry (geometry :x "20px" :y "60px" :width "420px" :height "140px"
                      :anchor "top right")
  (music-card))

;; -- Widget: Calendar ----------------------------------------------------------
(defwidget cal-card []
  (box :class "calendar" :orientation "v" :space-evenly false
    (label :class "cal-clock" :text clock-time :halign "center")
    (label :class "cal-date"  :text clock-date :halign "center")
    (calendar :show-week-numbers false)))

(defwindow calendar
  :monitor 0
  :stacking "fg"
  :focusable "ondemand"
  :namespace "eww-calendar"
  :geometry (geometry :x "20px" :y "60px" :width "320px" :height "360px"
                      :anchor "top right")
  (cal-card))

;; -- Widget: Power menu --------------------------------------------------------
(defwidget pm-button [class icon label cmd]
  (box :orientation "v" :space-evenly false
    (button :class class :onclick cmd icon)
    (label  :class "pm-label" :text label)))

(defwidget power-menu-grid []
  (box :class "power-menu" :orientation "v" :space-evenly false
       :valign "center" :halign "center"
    (box :class "pm-row" :orientation "h" :space-evenly false
      (pm-button :class "pm-lock"     :icon "" :label "Lock"
                 :cmd "eww close power-menu && hyprlock")
      (pm-button :class "pm-logout"   :icon "󰍃" :label "Logout"
                 :cmd "eww close power-menu && hyprctl dispatch exit"))
    (box :class "pm-row" :orientation "h" :space-evenly false
      (pm-button :class "pm-reboot"   :icon "" :label "Reboot"
                 :cmd "eww close power-menu && systemctl reboot")
      (pm-button :class "pm-shutdown" :icon "" :label "Shutdown"
                 :cmd "eww close power-menu && systemctl poweroff"))))

(defwindow power-menu
  :monitor 0
  :stacking "overlay"
  :focusable true
  :namespace "eww-power-menu"
  :geometry (geometry :x "0" :y "0" :width "100%" :height "100%"
                      :anchor "center center")
  (power-menu-grid))

;; -- Widget: Sysinfo (CPU / RAM / disk / temp) --------------------------------
(defwidget si-row [class icon label value max-value]
  (box :class "si-row" :orientation "h" :space-evenly false
    (label :class "si-icon" :text icon)
    (box :orientation "v" :space-evenly false :hexpand true
      (box :orientation "h" :space-evenly false
        (label :class "si-label" :text label :halign "start" :hexpand true)
        (label :class "si-value" :text "${value}%" :halign "end"))
      (scale :class class :value value :min 0 :max max-value :active false))))

(defwidget sysinfo-card []
  (box :class "sysinfo" :orientation "v" :space-evenly false
    (si-row :class "si-cpu"  :icon "" :label "CPU"  :value cpu-usage  :max-value 100)
    (si-row :class "si-mem"  :icon "" :label "RAM"  :value mem-usage  :max-value 100)
    (si-row :class "si-disk" :icon "" :label "Disk" :value disk-usage :max-value 100)
    (si-row :class {temp-value > 85 ? "si-temp critical" : "si-temp"}
            :icon "" :label "Temp" :value temp-value :max-value 110)))

(defwindow sysinfo
  :monitor 0
  :stacking "fg"
  :focusable "ondemand"
  :namespace "eww-sysinfo"
  :geometry (geometry :x "20px" :y "60px" :width "320px" :height "240px"
                      :anchor "top right")
  (sysinfo-card))
