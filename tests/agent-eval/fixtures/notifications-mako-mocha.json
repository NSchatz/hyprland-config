{
  "name": "notifications-mako-mocha",
  "description": "Component-writer produces a mako config with the palette baked in (mako has no @include directive — colors must be literal hex). Must NOT contain [urgency=high] (mako only knows low|normal|critical).",
  "agent": "hyprland-component-writer",
  "surface": "notifications",
  "preset": "catppuccin-mocha",
  "answers": {
    "notification_daemon": "mako",
    "notification_anchor": "top-right",
    "notification_margin": 20,
    "notification_width": 380,
    "notification_height": 120,
    "notification_border_radius": 12
  },
  "assertions": [
    { "type": "file_exists",      "path": "mako/config" },
    { "type": "file_contains",    "path": "mako/config", "needle": "background-color" },
    { "type": "file_contains",    "path": "mako/config", "needle": "text-color" },
    { "type": "file_contains",    "path": "mako/config", "needle": "border-color" },
    { "type": "file_not_contains","path": "mako/config", "needle": "[urgency=high]" }
  ]
}
