{
  "name": "terminal-kitty-mocha",
  "description": "Component-writer produces a kitty config that includes the engine's colors.conf. Must use `include colors.conf` (kitty's own include syntax), not literal hex inlined.",
  "agent": "hyprland-component-writer",
  "surface": "terminal",
  "preset": "catppuccin-mocha",
  "answers": {
    "terminal_app": "kitty",
    "terminal_font": "JetBrainsMono Nerd Font",
    "terminal_font_size": 12,
    "terminal_padding": 14,
    "terminal_background_opacity": 0.92
  },
  "assertions": [
    { "type": "file_exists",   "path": "kitty/kitty.conf" },
    { "type": "file_contains", "path": "kitty/kitty.conf", "needle": "include colors.conf" },
    { "type": "file_contains", "path": "kitty/kitty.conf", "needle": "font_family" }
  ]
}
