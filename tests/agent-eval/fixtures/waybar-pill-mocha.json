{
  "name": "waybar-pill-mocha",
  "description": "Component-writer produces a centered-pill waybar against Catppuccin Mocha. Output must parse as strict JSON and import the engine's colors.css so the bar re-themes on palette swap.",
  "agent": "hyprland-component-writer",
  "surface": "waybar",
  "preset": "catppuccin-mocha",
  "answers": {
    "bar_style": "centered-pill",
    "bar_position": "top",
    "bar_modules_left": ["sway/workspaces", "sway/mode"],
    "bar_modules_center": ["clock"],
    "bar_modules_right": ["cpu", "memory", "tray"],
    "clock_format": "{:%H:%M  %a %d %b}"
  },
  "assertions": [
    { "type": "file_exists",    "path": "waybar/config.jsonc" },
    { "type": "file_exists",    "path": "waybar/style.css" },
    { "type": "json_parses",    "path": "waybar/config.jsonc" },
    { "type": "file_contains",  "path": "waybar/style.css", "needle": "@import" },
    { "type": "file_contains",  "path": "waybar/style.css", "needle": "colors.css" }
  ]
}
