{
  "name": "launcher-wofi-mocha",
  "description": "Component-writer produces a wofi launcher (config + style.css) themed off colors.css. Window must have an accent border so per-preset re-theming is visible.",
  "agent": "hyprland-component-writer",
  "surface": "launcher",
  "preset": "catppuccin-mocha",
  "answers": {
    "launcher_app": "wofi",
    "launcher_mode": "drun",
    "launcher_width": 600,
    "launcher_height": 400,
    "launcher_location": "center"
  },
  "assertions": [
    { "type": "file_exists",   "path": "wofi/config" },
    { "type": "file_exists",   "path": "wofi/style.css" },
    { "type": "file_contains", "path": "wofi/style.css", "needle": "@import" },
    { "type": "file_contains", "path": "wofi/style.css", "needle": "@accent" }
  ]
}
