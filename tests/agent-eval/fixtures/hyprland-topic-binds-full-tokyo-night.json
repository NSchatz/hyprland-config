{
  "name": "hyprland-topic-binds-full-tokyo-night",
  "description": "Hyprland binds.conf. mod=SUPER, flavor=i3-sway, vim navigation on, resize_submap on, cheatsheet + theme-toggle extras. Tests $mainMod = SUPER macro emission, the i3/sway flavor's mod+Return = terminal pattern, and the theme-toggle binds wiring theme_dark/theme_light.",
  "agent": "hyprland-component-writer",
  "surface": "hyprland-topic",
  "preset": "tokyo-night",
  "answers": {
    "version": 1,
    "staging_dir": "/tmp/hypr-gen-regression-eval",
    "hypr_version": "0.55.0",
    "accessibility": [
      "large-cursor",
      "night-light",
      "larger-ui"
    ],
    "autostart_env": {
      "wallpaper_tool": "swww",
      "polkit": "hyprpolkitagent",
      "dbus_propagation": "explicit",
      "autostart": [
        "cliphist-text",
        "cliphist-image",
        "nm-applet",
        "blueman",
        "hypridle",
        "hyprsunset",
        "swayosd"
      ],
      "env": [
        "XDG_CURRENT_DESKTOP,Hyprland",
        "XDG_SESSION_TYPE,wayland",
        "XDG_SESSION_DESKTOP,Hyprland",
        "QT_QPA_PLATFORM,wayland;xcb",
        "QT_WAYLAND_DISABLE_WINDOWDECORATION,1",
        "GDK_BACKEND,wayland,x11,*",
        "MOZ_ENABLE_WAYLAND,1",
        "CLUTTER_BACKEND,wayland",
        "_JAVA_AWT_WM_NONREPARENTING,1",
        "ELECTRON_OZONE_PLATFORM_HINT,auto"
      ]
    },
    "companion_configs": {
      "hyprlock": true,
      "hypridle_ladder": "balanced",
      "hyprpaper": false,
      "wlogout": true,
      "cursor_theme": "Bibata-Modern-Classic"
    },
    "default_apps": {
      "browser": "firefox",
      "files": "nautilus"
    },
    "gaming": {
      "enabled": true,
      "tearing_classes": [
        "^(cs2|hl2_linux|portal2_linux)$"
      ],
      "vrr_mode": 2,
      "strip_fullscreen_effects": true,
      "gamemode_toggle": true,
      "system_gamemoded": true
    },
    "input": {
      "kb_layout": "us",
      "kb_options": [
        "caps:swapescape",
        "compose:ralt"
      ],
      "key_repeat": {
        "rate": 25,
        "delay": 600
      },
      "follow_mouse": 1,
      "mouse_sensitivity": 0.0,
      "touchpad_gestures": [
        "workspace-swipe",
        "window-move",
        "fullscreen-3up"
      ]
    },
    "keybinds": {
      "mod": "SUPER",
      "flavor": "i3-sway",
      "vim": true,
      "resize_submap": true,
      "extras": [
        "cheatsheet",
        "theme-toggle"
      ],
      "theme_dark": "tokyo-night",
      "theme_light": "catppuccin-latte"
    },
    "laptop": {
      "enabled": true,
      "lid_action": "suspend",
      "power_tool": "ppd",
      "charge_limit": 80
    },
    "launcher": {
      "tool": "wofi",
      "mode": "drun",
      "layout": "centered",
      "icons": true,
      "behavior": [
        "fuzzy",
        "type-to-search",
        "close-on-focus-loss"
      ]
    },
    "lock_screen": {
      "enabled": true,
      "background": "blurred-screenshot",
      "clock": "large",
      "input_pill": "accent-outlined",
      "fingerprint": false
    },
    "login_boot": {
      "greeter": "sddm",
      "plymouth": true,
      "grub_theme": true
    },
    "look_feel": {
      "gaps_preset": "comfortable",
      "rounding": "rounded",
      "blur_shadows": "both-on",
      "opacity": {
        "active": 1.0,
        "inactive": 0.92
      },
      "animations": "smooth",
      "border_color": "palette",
      "border_gradient": null,
      "layout": "dwindle",
      "master_orientation": null,
      "groups": true,
      "per_app_rules": [
        {
          "class": "^(pavucontrol|nm-connection-editor|blueman-manager)$",
          "effects": [
            "float = yes",
            "size 720 480",
            "center"
          ]
        },
        {
          "class": "^(org\\.kde\\.polkit-kde-authentication-agent-1|hyprpolkitagent)$",
          "effects": [
            "float = yes",
            "pin"
          ]
        },
        {
          "class": "^(firefox)$",
          "title": "^(Picture-in-Picture)$",
          "effects": [
            "float = yes",
            "pin",
            "noanim",
            "opacity 1.0"
          ]
        },
        {
          "class": "^(steam)$",
          "effects": [
            "workspace 6 silent"
          ]
        }
      ],
      "blur_toggle": true
    },
    "monitors": {
      "setup": "dual-side-by-side",
      "list": [
        {
          "name": "DP-1",
          "mode": "2560x1440@144",
          "pos": "0x0",
          "scale": 1.0,
          "transform": 0,
          "vrr": 2,
          "bitdepth": 10,
          "mirror": null,
          "icc": null,
          "disabled": false
        },
        {
          "name": "HDMI-A-1",
          "mode": "1920x1080@60",
          "pos": "2560x0",
          "scale": 1.0,
          "transform": 0,
          "vrr": 0,
          "bitdepth": 8,
          "mirror": null,
          "icc": null,
          "disabled": false
        }
      ],
      "scaling": 1.0,
      "dock_undock": false,
      "workspace_rules": {
        "1-5": "DP-1",
        "6-10": "HDMI-A-1",
        "scratchpad": true,
        "smart_gaps": true,
        "persistent": [
          "1",
          "2",
          "9"
        ]
      },
      "pin_apps": {
        "firefox": "1",
        "kitty": "2",
        "Spotify": "9"
      }
    },
    "notifications": {
      "daemon": "mako",
      "position": "top-right",
      "timeout": 5,
      "behavior": [
        "group-by-app",
        "app-icons",
        "dnd-bind"
      ]
    },
    "plugins": {
      "enabled": true,
      "selected": [
        "hyprexpo",
        "hyprbars",
        "hyprtrails"
      ]
    },
    "shell_prompt": {
      "shell": "fish",
      "prompt": "starship",
      "fish_colors": true,
      "fetch": "fastfetch",
      "fisher": [
        "jorgebucaran/fisher",
        "PatrickF1/fzf.fish",
        "jorgebucaran/autopair.fish"
      ],
      "aliases": true,
      "modern_cli": [
        "eza",
        "bat",
        "zoxide",
        "fzf",
        "atuin"
      ]
    },
    "terminal": {
      "emulator": "kitty",
      "opacity": 0.92,
      "padding": 14,
      "font_size": 12,
      "cursor": {
        "shape": "beam",
        "blink": true
      },
      "extras": [
        "ligatures",
        "scrollback-10k",
        "bell-off"
      ],
      "swallow": false
    },
    "utilities": {
      "selected": [
        "screenshot",
        "clipboard",
        "color-picker",
        "power-menu",
        "emoji",
        "calculator",
        "wifi-applet",
        "bluetooth-applet",
        "night-light"
      ],
      "osd_route": "swayosd",
      "session_picker": "wlogout"
    },
    "bar": {
      "strategy": "waybar+widgets",
      "form": "top",
      "height": 34,
      "archetype": "floating-islands",
      "corner": "pill",
      "transparency": "translucent",
      "depth": "shadow",
      "workspace_indicator": "pill-fill",
      "accent_strategy": "single",
      "accent_application": "text",
      "motion": "smooth",
      "modules": [
        "hyprland/workspaces",
        "hyprland/window",
        "clock",
        "pulseaudio",
        "network",
        "cpu",
        "memory",
        "tray"
      ],
      "grouping": "inline",
      "clock_format": "24h-date-tooltip"
    },
    "widgets": {
      "system": "eww",
      "turnkey": null,
      "enabled": [
        "osd",
        "music",
        "calendar",
        "power-menu",
        "sysinfo"
      ],
      "look": "match-palette",
      "motion": "smooth"
    },
    "palette": {
      "source": "named",
      "scheme": "tokyo-night",
      "accent": null
    },
    "fonts": {
      "ui_family": "Inter",
      "ui_size": 11,
      "ui_scale": 1.0,
      "mono_family": "JetBrainsMono Nerd Font",
      "mono_size": 12
    },
    "wallpaper": {
      "source": "rice-bundled",
      "path": "~/.config/hypr-rice/wallpapers/tokyo-night.jpg",
      "mode": "fill"
    }
  },
  "assertions": [
    {
      "type": "file_exists",
      "path": "binds.conf"
    },
    {
      "type": "file_contains",
      "path": "binds.conf",
      "needle": "$mainMod"
    },
    {
      "type": "file_contains",
      "path": "binds.conf",
      "needle": "SUPER"
    },
    {
      "type": "file_contains",
      "path": "binds.conf",
      "needle": "bind"
    }
  ],
  "topic": "binds"
}