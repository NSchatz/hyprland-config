#!/usr/bin/env bash
# hypr-rice — self-contained desktop theme engine CLI.
# Installed by the hyprland-config Claude Code plugin into ~/.config/hypr-rice/.
# Keeps working without the plugin. Run `rice help`.
set -uo pipefail
RICE_DIR="${RICE_DIR:-$HOME/.config/hypr-rice}"

cmd="${1:-help}"; shift 2>/dev/null || true

case "$cmd" in
    apply)
        # Render every template from palette.conf and reload apps.
        bash "$RICE_DIR/render-templates.sh" "$@"
        # Apply recorded GTK/cursor/font settings, if present.
        if [ -f "$RICE_DIR/apply-extra.sh" ]; then bash "$RICE_DIR/apply-extra.sh" || true; fi
        ;;
    wallpaper)
        # Set wallpaper, regenerate the palette from it, then re-theme everything.
        img="${1:-}"; [ -n "$img" ] || { echo "usage: rice wallpaper <image> [--no-theme]" >&2; exit 1; }
        shift 2>/dev/null || true
        bash "$RICE_DIR/set-wallpaper.sh" "$img"
        if [ "${1:-}" != "--no-theme" ]; then
            bash "$RICE_DIR/palette-from-wallpaper.sh" "$img" && bash "$RICE_DIR/render-templates.sh"
        fi
        ;;
    random)
        # Pick a random wallpaper from a dir (default ~/Pictures/wallpapers) and apply it.
        dir="${1:-$HOME/Pictures/wallpapers}"
        img="$(find "$dir" -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) 2>/dev/null | shuf -n1)"
        [ -n "$img" ] || { echo "no images found in $dir" >&2; exit 1; }
        exec "$0" wallpaper "$img"
        ;;
    palette)
        cat "$RICE_DIR/palette.conf" 2>/dev/null || echo "no palette yet ($RICE_DIR/palette.conf)";;
    templates|list)
        cat "$RICE_DIR/templates.list" 2>/dev/null || echo "no manifest yet";;
    edit)
        "${EDITOR:-nano}" "$RICE_DIR/palette.conf";;
    help|-h|--help)
        cat <<EOF
hypr-rice — desktop theme engine ($RICE_DIR)

  rice apply              render all templates from palette.conf and reload apps
  rice apply --no-reload  render only (no app reloads)
  rice wallpaper <img>    set wallpaper, regenerate palette from it, and re-theme
  rice wallpaper <img> --no-theme   set wallpaper only
  rice random [dir]       random wallpaper from dir (default ~/Pictures/wallpapers) + re-theme
  rice palette            print the current palette
  rice templates          print the template manifest (name -> output -> reload)
  rice edit               edit palette.conf in \$EDITOR

Add an app: drop a <name>.tmpl in templates/ (use {{accent}}, {{bg}}, {{color0}}…)
and add a TAB-separated line to templates.list, then \`rice apply\`.
EOF
        ;;
    *) echo "unknown command: $cmd  (try: rice help)" >&2; exit 1;;
esac
