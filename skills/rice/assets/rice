#!/usr/bin/env bash
# hypr-rice - self-contained desktop theme engine CLI.
# Installed by the hyprland-config Claude Code plugin into <config base>/hypr-rice/, the base
# being $XDG_CONFIG_HOME when it is an absolute path and $HOME/.config otherwise. $RICE_DIR
# overrides both. Keeps working without the plugin. Run `rice help`.
#
# THE IMPLEMENTATION IS PYTHON (scripts/ricelib/ricecli.py). This stays a bash entry point
# because it is what the user's keybinds, the dotfiles repo and every doc invoke by name.
set -uo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
libdir=""
for c in "$here" "$here/../../../scripts" "${CLAUDE_PLUGIN_ROOT:-}/scripts" "${RICE_DIR:-}"; do
    if [ -n "$c" ] && [ -f "$c/ricelib/__init__.py" ]; then libdir="$(cd "$c" && pwd)"; break; fi
done
if [ -z "$libdir" ]; then
    echo "ERROR: the ricelib package was not found next to $0, in \$CLAUDE_PLUGIN_ROOT/scripts, or in \$RICE_DIR - re-run rice-init.sh." >&2
    exit 2
fi
if ! command -v python3 >/dev/null 2>&1; then
    echo "ERROR: python3 is required and is not installed." >&2
    echo "       Install it with: sudo pacman -S --needed python" >&2
    echo "       (or run: bash \"$here/ensure-python.sh\")" >&2
    exit 2
fi

PYTHONPATH="$libdir${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m ricelib.ricecli "$@"
