#!/usr/bin/env bash
# hypr-rice — self-contained desktop theme engine CLI.
# Installed by the hyprland-config Claude Code plugin into <config base>/hypr-rice/, the base
# being $XDG_CONFIG_HOME when it is an absolute path and $HOME/.config otherwise. $RICE_DIR
# overrides both. Keeps working without the plugin. Run `rice help`.
set -uo pipefail

# The one decision about where configuration lives, installed beside this CLI by rice-init.sh.
_xdg_lib=""
for _c in "$(cd "$(dirname "$0")" && pwd)/xdg-config.sh" \
          "$(cd "$(dirname "$0")" && pwd)/../../../scripts/xdg-config.sh" \
          "${CLAUDE_PLUGIN_ROOT:-}/scripts/xdg-config.sh"; do
    if [ -n "$_c" ] && [ -f "$_c" ]; then _xdg_lib="$_c"; break; fi
done
if [ -z "$_xdg_lib" ]; then
    echo "ERROR: the config-path library (xdg-config.sh) was not found next to $0 - re-run rice-init.sh." >&2
    exit 2
fi
# shellcheck source=../../../scripts/xdg-config.sh
. "$_xdg_lib"
if ! xdg_config_target hypr-rice "${RICE_DIR:-}"; then
    echo "RICE=refused-no-config-dir" >&2
    exit 2
fi
RICE_DIR="$XDG_CONFIG_TARGET"

cmd="${1:-help}"; shift 2>/dev/null || true

case "$cmd" in
    apply)
        # Render every template from palette.conf and reload apps. One restore point per apply:
        # mint the id here so every stage this command runs shares it and `rice restore <id>`
        # puts the whole set back.
        if [ -z "${RICE_APPLY_ID:-}" ] && [ -f "$RICE_DIR/restore-point.sh" ]; then
            RICE_APPLY_ID="$(bash "$RICE_DIR/restore-point.sh" new-id)"; export RICE_APPLY_ID
        fi
        bash "$RICE_DIR/render-templates.sh" "$@"
        # Apply recorded GTK/cursor/font settings, if present.
        if [ -f "$RICE_DIR/apply-extra.sh" ]; then bash "$RICE_DIR/apply-extra.sh" || true; fi
        ;;
    restore)
        # Put every file one apply wrote back the way it was, as one set.
        #   rice restore <apply-id>   undo that apply
        #   rice restore --list       what can be undone (newest first)
        [ -f "$RICE_DIR/rice-restore.sh" ] || { echo "no restore command installed ($RICE_DIR/rice-restore.sh): re-run rice-init.sh" >&2; exit 1; }
        bash "$RICE_DIR/rice-restore.sh" "$@"
        ;;
    wallpaper)
        # Set wallpaper, regenerate the palette from it, then re-theme everything.
        # Setting a wallpaper is always the source of truth: persist `wallpaper=` to
        # palette.conf before any --no-theme short-circuit, so the next `rice apply` /
        # `rice theme` / `rice save` carries it.
        img="${1:-}"; [ -n "$img" ] || { echo "usage: rice wallpaper <image> [--no-theme]" >&2; exit 1; }
        shift 2>/dev/null || true
        bash "$RICE_DIR/set-wallpaper.sh" "$img"
        pc="$RICE_DIR/palette.conf"
        if [ -f "$pc" ]; then
            if grep -q '^wallpaper=' "$pc"; then sed -i "s|^wallpaper=.*|wallpaper=$img|" "$pc"
            else printf 'wallpaper=%s\n' "$img" >> "$pc"; fi
        fi
        if [ "${1:-}" != "--no-theme" ]; then
            bash "$RICE_DIR/palette-from-wallpaper.sh" "$img" && bash "$RICE_DIR/render-templates.sh"
        fi
        ;;
    random)
        # Pick a random wallpaper from a dir (default ~/Pictures/wallpapers) and apply it.
        dir="${1:-$HOME/Pictures/wallpapers}"
        img="$(find "$dir" -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) 2>/dev/null | shuf -n1)"
        [ -n "$img" ] || { echo "no images found in $dir" >&2; exit 1; }
        exec "$0" wallpaper "$img"
        ;;
    wallpapers)
        # List curated, theme-tagged downloadable wallpapers. Optional <scheme> filters to that
        # scheme plus the theme-agnostic `any` set; no arg lists everything grouped by scheme.
        # Catalog schema: scheme<TAB>name<TAB>width<TAB>url (width is `?` if unknown).
        cat="$RICE_DIR/wallpapers.tsv"
        [ -f "$cat" ] || { echo "no wallpaper catalog ($cat)" >&2; exit 1; }
        want="${1:-}"
        awk -F'\t' -v want="$want" '
            function m(s,w){ return (w=="" || s==w || index(s,w"-")==1 || index(w,s"-")==1) }
            /^[[:space:]]*#/ || NF<4 { next }
            (m($1,want) || $1=="any") {
                if ($1!=last) { printf "\n[%s]\n", $1; last=$1 }
                n++; printf "  %2d) %-26s %6s  %s\n", n, $2, ($3=="?"?"?":$3"px"), $4
            }' "$cat"
        echo
        echo "Download one with:  rice get-wallpaper <scheme> <number|name> [--set] [--min-res W]"
        ;;
    get-wallpaper|wallpaper-get)
        # Download a catalog wallpaper by scheme + selector (number within that scheme's list,
        # counting its `any` entries too, or a name substring). --set also applies it (keeps the
        # current palette — no re-theme). --dir overrides the destination. --min-res W filters out
        # entries narrower than W pixels (unknown widths are dropped).
        scheme="${1:-}"; sel="${2:-}"
        [ -n "$scheme" ] && [ -n "$sel" ] || { echo "usage: rice get-wallpaper <scheme> <number|name> [--set] [--dir DIR] [--min-res W]" >&2; exit 1; }
        shift 2 2>/dev/null || true
        do_set=0; dir="$HOME/Pictures/wallpapers"; min_res=0
        while [ $# -gt 0 ]; do
            case "$1" in
                --set) do_set=1;;
                --dir) shift; dir="${1:-$dir}";;
                --min-res) shift; min_res="${1:-0}";;
            esac
            shift
        done
        cat="$RICE_DIR/wallpapers.tsv"
        [ -f "$cat" ] || { echo "no wallpaper catalog ($cat)" >&2; exit 1; }
        # Catalog rows are listed in descending-width order per scheme, so the first match is the
        # highest-res entry. With --min-res W, drop rows whose width is unknown (`?`) or below W.
        mapfile -t rows < <(awk -F'\t' -v want="$scheme" -v minw="$min_res" '
            function m(s,w){ return (s==w || index(s,w"-")==1 || index(w,s"-")==1) }
            /^[[:space:]]*#/ || NF<4 { next }
            (m($1,want) || $1=="any") {
                w = ($3=="?" ? 0 : $3+0)
                if (minw>0 && w<minw) next
                printf "%s\t%s\n", $2, $4
            }' "$cat")
        [ "${#rows[@]}" -gt 0 ] || { echo "no wallpapers for scheme '$scheme' (see: rice wallpapers)" >&2; exit 1; }
        pick=""
        if printf '%s' "$sel" | grep -qE '^[0-9]+$'; then
            idx=$((sel)); [ "$idx" -ge 1 ] && [ "$idx" -le "${#rows[@]}" ] && pick="${rows[$((idx-1))]}"
        fi
        if [ -z "$pick" ]; then
            for r in "${rows[@]}"; do case "${r%%$'\t'*}" in *"$sel"*) pick="$r"; break;; esac; done
        fi
        [ -n "$pick" ] || { echo "no match for '$sel' in scheme '$scheme' (see: rice wallpapers $scheme)" >&2; exit 1; }
        name="${pick%%$'\t'*}"; url="${pick#*$'\t'}"
        ext="${url##*.}"; case "$ext" in jpg|jpeg|png|webp) ;; *) ext="jpg";; esac
        mkdir -p "$dir"; out="$dir/${scheme}-${name}.${ext}"
        echo "Downloading $name → $out"
        curl -fL --retry 2 --connect-timeout 20 -o "$out" "$url" || { echo "DOWNLOAD=failed ($url)" >&2; exit 1; }
        echo "WALLPAPER=$out"
        if [ "$do_set" -eq 1 ]; then
            pal="$RICE_DIR/palette.conf"
            if [ -f "$pal" ]; then
                if grep -q '^wallpaper=' "$pal"; then sed -i "s|^wallpaper=.*|wallpaper=$out|" "$pal"
                else printf 'wallpaper=%s\n' "$out" >> "$pal"; fi
            fi
            bash "$RICE_DIR/set-wallpaper.sh" "$out" && echo "SET=ok"
        fi
        ;;
    accents)
        # List the accent variants for a scheme (default: the current palette's scheme).
        acc="$RICE_DIR/accents.tsv"
        [ -f "$acc" ] || { echo "no accent catalog ($acc)" >&2; exit 1; }
        want="${1:-$(sed -n 's/^scheme=//p' "$RICE_DIR/palette.conf" 2>/dev/null | head -1)}"
        cur="$(sed -n 's/^accent=//p' "$RICE_DIR/palette.conf" 2>/dev/null | head -1)"
        awk -F'\t' -v want="$want" -v cur="$cur" '
            function m(s,w){ return (w=="" || s==w || index(s,w"-")==1 || index(w,s"-")==1) }
            /^[[:space:]]*#/ || NF<3 { next }
            m($1,want) { n++; printf "  %2d) %-10s #%s%s\n", n, $2, $3, (tolower($3)==tolower(cur)?"  (current)":"") }' "$acc"
        echo
        echo "Set one with:  rice accent <name|hex> [--pin]"
        ;;
    accent)
        # Set the accent for the current scheme by variant name or raw hex. --pin writes it to
        # palette.user.conf (survives every theme/wallpaper change); default writes palette.conf.
        sel="${1:-}"; [ -n "$sel" ] || { echo "usage: rice accent <name|hex> [--pin]  (see: rice accents)" >&2; exit 1; }
        shift 2>/dev/null || true
        pin=0; [ "${1:-}" = "--pin" ] && pin=1
        acc="$RICE_DIR/accents.tsv"
        scheme="$(sed -n 's/^scheme=//p' "$RICE_DIR/palette.conf" 2>/dev/null | head -1)"
        hex=""
        if printf '%s' "$sel" | grep -qiE '^[0-9a-f]{6}$'; then
            hex="$(printf '%s' "$sel" | tr 'A-F' 'a-f')"
        elif [ -f "$acc" ]; then
            hex="$(awk -F'\t' -v want="$scheme" -v name="$sel" '
                function m(s,w){ return (s==w || index(s,w"-")==1 || index(w,s"-")==1) }
                /^[[:space:]]*#/ || NF<3 { next }
                m($1,want) && $2==name { print $3; exit }' "$acc")"
        fi
        [ -n "$hex" ] || { echo "no accent '$sel' for scheme '$scheme' (see: rice accents)" >&2; exit 1; }
        if [ "$pin" -eq 1 ]; then target="$RICE_DIR/palette.user.conf"; else target="$RICE_DIR/palette.conf"; fi
        touch "$target"
        if grep -q '^accent=' "$target"; then sed -i "s|^accent=.*|accent=$hex|" "$target"
        else printf 'accent=%s\n' "$hex" >> "$target"; fi
        if [ "$pin" -eq 1 ]; then echo "ACCENT=$hex (pinned in palette.user.conf)"; else echo "ACCENT=$hex"; fi
        bash "$RICE_DIR/render-templates.sh"
        ;;
    save)
        # Snapshot the current palette as a named profile.
        name="${1:-}"; [ -n "$name" ] || { echo "usage: rice save <name>" >&2; exit 1; }
        mkdir -p "$RICE_DIR/profiles"
        cp "$RICE_DIR/palette.conf" "$RICE_DIR/profiles/$name.conf"
        echo "SAVED profile '$name'";;
    theme|load)
        # Load a saved profile's palette, set its wallpaper if recorded, and re-theme.
        # `wallpaper=` in the profile may be either a local path or a catalog selector
        # `<scheme>:<name>` — selectors are resolved through `rice get-wallpaper`, downloading
        # to ~/Pictures/wallpapers/ on first use. This lets shipped preset profiles carry a
        # wallpaper assignment without bundling the image.
        name="${1:-}"; [ -n "$name" ] || { echo "usage: rice theme <name>  (see: rice themes)" >&2; exit 1; }
        src="$RICE_DIR/profiles/$name.conf"
        [ -f "$src" ] || { echo "no profile '$name' (see: rice themes)" >&2; exit 1; }
        cp "$src" "$RICE_DIR/palette.conf"
        wp="$(sed -n 's/^wallpaper=//p' "$RICE_DIR/palette.conf" | head -1)"; wp="${wp/#\~/$HOME}"
        # Catalog-selector form: `scheme:name` (no `/`, no leading `~`, contains `:`).
        if [ -n "$wp" ] && [ ! -f "$wp" ] && printf '%s' "$wp" | grep -qE '^[A-Za-z0-9-]+:[A-Za-z0-9._-]+$'; then
            sch="${wp%%:*}"; sel="${wp##*:}"
            resolved="$(bash "$0" get-wallpaper "$sch" "$sel" 2>/dev/null | sed -n 's/^WALLPAPER=//p' | tail -1)"
            if [ -n "$resolved" ] && [ -f "$resolved" ]; then
                # Persist the resolved local path so subsequent applies don't re-download.
                pc="$RICE_DIR/palette.conf"
                sed -i "s|^wallpaper=.*|wallpaper=$resolved|" "$pc"
                wp="$resolved"
            else
                echo "WARN: could not resolve wallpaper selector '$wp' — skipping wallpaper set" >&2
                wp=""
            fi
        fi
        [ -n "$wp" ] && [ -f "$wp" ] && bash "$RICE_DIR/set-wallpaper.sh" "$wp" >/dev/null 2>&1
        bash "$RICE_DIR/render-templates.sh"
        echo "APPLIED profile '$name'";;
    themes|list-themes)
        if ls "$RICE_DIR/profiles"/*.conf >/dev/null 2>&1; then
            for p in "$RICE_DIR/profiles"/*.conf; do basename "$p" .conf; done
        else echo "(no profiles yet — save one with: rice save <name>)"; fi;;
    theme-toggle)
        # Flip between two profiles by name — the dark/light (or any A/B) toggle keybind.
        # Reads the current scheme from palette.conf; applies whichever of the two it is NOT.
        a="${1:-}"; b="${2:-}"
        [ -n "$a" ] && [ -n "$b" ] || { echo "usage: rice theme-toggle <profileA> <profileB>" >&2; exit 1; }
        cur="$(sed -n 's/^scheme=//p' "$RICE_DIR/palette.conf" 2>/dev/null | head -1)"
        if [ "$cur" = "$a" ]; then exec "$0" theme "$b"; else exec "$0" theme "$a"; fi;;
    theme-next)
        # Cycle to the next saved profile (alphabetical) — a single-key theme cycler, no menu needed.
        ls "$RICE_DIR/profiles"/*.conf >/dev/null 2>&1 || { echo "(no profiles to cycle)" >&2; exit 1; }
        cur="$(sed -n 's/^scheme=//p' "$RICE_DIR/palette.conf" 2>/dev/null | head -1)"
        names=""; for p in "$RICE_DIR/profiles"/*.conf; do names="$names $(basename "$p" .conf)"; done
        set -- $names; first="$1"; nxt=""; take=0
        for n in "$@"; do [ "$take" = 1 ] && { nxt="$n"; break; }; [ "$n" = "$cur" ] && take=1; done
        [ -n "$nxt" ] || nxt="$first"
        exec "$0" theme "$nxt";;
    palette)
        cat "$RICE_DIR/palette.conf" 2>/dev/null || echo "no palette yet ($RICE_DIR/palette.conf)";;
    templates|list)
        cat "$RICE_DIR/templates.list" 2>/dev/null || echo "no manifest yet";;
    edit)
        "${EDITOR:-nano}" "$RICE_DIR/palette.conf";;
    help|-h|--help)
        cat <<EOF
hypr-rice — desktop theme engine ($RICE_DIR)

  rice apply              render all templates from palette.conf and reload apps
  rice apply --no-reload  render only (no app reloads)
  rice restore <apply-id> put every file that apply wrote back the way it was (one command,
                          whole set: rendered surfaces, browser profile files, shell rc files;
                          files the apply created are removed again)
  rice restore --list     list what can still be undone, newest first
  rice wallpaper <img>    set wallpaper, regenerate palette from it, and re-theme
  rice wallpaper <img> --no-theme   set wallpaper only
  rice random [dir]       random wallpaper from dir (default ~/Pictures/wallpapers) + re-theme
  rice wallpapers [scheme]          list curated downloadable wallpapers (filter by scheme)
  rice get-wallpaper <scheme> <n|name> [--set] [--dir DIR]
                          curl-download a catalog wallpaper; --set applies it (keeps the palette)
  rice accents [scheme]   list the accent variants for a scheme (default: current)
  rice accent <name|hex> [--pin]    set the accent (in-palette name or raw hex); --pin = survive re-theme
  rice theme <name>       load a saved profile (palette + wallpaper) and re-theme
                          NOTE: profiles are PALETTE-ONLY — structural look
                          (looknfeel.conf, waybar style.css, hyprlock layout, etc.)
                          does not travel with rice theme. Manage structural
                          changes via the dotfiles skill instead.
  rice theme-toggle <a> <b>  flip between two profiles (the dark/light toggle keybind)
  rice theme-next         cycle to the next saved profile (single-key theme cycler)
  rice save <name>        snapshot the current palette as a profile (palette only —
                          structural look stays in the live config)
  rice themes             list saved profiles
  rice palette            print the current palette
  rice templates          print the template manifest (name -> output -> reload)
  rice edit               edit palette.conf in \$EDITOR

Personal overrides: put KEY=hex lines in palette.user.conf — they win over every
theme/wallpaper change (cascade: generated -> user), so your tweaks always survive.

Add an app: drop a <name>.tmpl in templates/ (use {{accent}}, {{bg}}, {{color0}}…)
and add a TAB-separated line to templates.list, then \`rice apply\`.
EOF
        ;;
    *) echo "unknown command: $cmd  (try: rice help)" >&2; exit 1;;
esac
