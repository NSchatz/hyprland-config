/* Generated by hypr-rice — ~/.config/gtk-4.0/gtk.css (libadwaita color overrides).
 * Keys verified against the libadwaita CSS-variables doc (1.6/main) and the matugen
 * gtk-colors templates shipped by end-4/dots-hyprland, mylinuxforwork/dotfiles,
 * AvengeMedia/DankMaterialShell, dusklinux/dusky, binnewbs/arch-hyprland. */
@define-color accent_color #{{accent}};
@define-color accent_bg_color #{{accent}};
@define-color accent_fg_color #{{bg}};
@define-color window_bg_color #{{bg}};
@define-color window_fg_color #{{fg}};
@define-color view_bg_color #{{bg}};
@define-color view_fg_color #{{fg}};
@define-color headerbar_bg_color #{{surface}};
@define-color headerbar_fg_color #{{fg}};
/* Backdrop pair — DMS notes "prevents white flash on window unfocus"; alias the
 * focused color so a backgrounded GTK4 window doesn't blink to stock Adwaita. */
@define-color headerbar_backdrop_color #{{surface}};
@define-color card_bg_color #{{surface}};
@define-color card_fg_color #{{fg}};
@define-color popover_bg_color #{{surface}};
@define-color popover_fg_color #{{fg}};
@define-color dialog_bg_color #{{surface}};
@define-color dialog_fg_color #{{fg}};
/* Sidebar pair — Nautilus, GNOME Files, Loupe, etc. read these (libadwaita 1.4+). */
@define-color sidebar_bg_color #{{bg}};
@define-color sidebar_fg_color #{{fg}};
@define-color sidebar_backdrop_color #{{bg}};
@define-color sidebar_border_color #{{bg}};
/* Signal colors. error_* mirrors destructive_* for Material-spec apps (DMS pattern). */
@define-color destructive_color #{{red}};
@define-color error_color #{{red}};
@define-color success_color #{{green}};
@define-color warning_color #{{yellow}};
