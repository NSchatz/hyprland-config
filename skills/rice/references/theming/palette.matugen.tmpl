# matugen template -> palette.conf (Material You roles). Hex include '#'; the
# palette-from-wallpaper.sh script strips it. ANSI color0..15 from MD3 is approximate.
#
# Contract: this template MUST emit every KEY that any component-level `.tmpl`
# in `references/components/*/*.tmpl` references as `{{KEY}}`. The current set
# is 29 keys: accent, accent2, bg, blue, color0..15, cursor, cyan, fg, green,
# magenta, muted, red, surface, yellow. Plus 4 metadata keys (scheme, font_ui,
# font_mono, font_ui_scale) read by the rice CLI itself, not by template
# substitution — they live in palette.conf so a wallpaper-cycle regen
# preserves them.
#
# Validator (run by `rice apply` and CI): missing-export = component .tmpl
# references {{KEY}} but this file doesn't emit KEY= → render emits an empty
# hex `#` and the colors file fails to parse. Orphan-export = this file emits
# KEY= but no component .tmpl references {{KEY}} → harmless padding (the value
# never reaches a render output), but flagged so the next contract bump catches
# it. The three metadata keys above are NOT orphans — they're the rice state.
scheme=material-you
bg={{colors.surface.default.hex}}
fg={{colors.on_surface.default.hex}}
surface={{colors.surface_container.default.hex}}
muted={{colors.outline.default.hex}}
cursor={{colors.primary.default.hex}}
accent={{colors.primary.default.hex}}
accent2={{colors.secondary.default.hex}}
red={{colors.error.default.hex}}
green={{colors.tertiary.default.hex}}
yellow={{colors.secondary.default.hex}}
blue={{colors.primary.default.hex}}
magenta={{colors.tertiary.default.hex}}
cyan={{colors.secondary.default.hex}}
color0={{colors.surface.default.hex}}
color1={{colors.error.default.hex}}
color2={{colors.tertiary.default.hex}}
color3={{colors.secondary.default.hex}}
color4={{colors.primary.default.hex}}
color5={{colors.tertiary.default.hex}}
color6={{colors.secondary.default.hex}}
color7={{colors.on_surface_variant.default.hex}}
color8={{colors.outline.default.hex}}
color9={{colors.error.default.hex}}
color10={{colors.tertiary.default.hex}}
color11={{colors.secondary.default.hex}}
color12={{colors.primary.default.hex}}
color13={{colors.tertiary.default.hex}}
color14={{colors.secondary.default.hex}}
color15={{colors.on_surface.default.hex}}
# Fonts are NOT derived from the wallpaper — keep them so every regen (e.g. the hourly cycle)
# preserves them instead of dropping font_ui/font_mono/font_ui_scale from palette.conf. Edit to taste.
font_ui=Inter 11
font_mono=JetBrainsMono Nerd Font 11
font_ui_scale=1.0
