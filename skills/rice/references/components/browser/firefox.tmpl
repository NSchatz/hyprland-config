    --rice-surface: #{{surface}};
    --rice-muted:   #{{muted}};
    --rice-accent:  #{{accent}};
    --rice-accent2: #{{accent2}};
    --rice-red:     #{{red}};
    --rice-green:   #{{green}};
    --rice-yellow:  #{{yellow}};
    --rice-blue:    #{{blue}};
    --rice-magenta: #{{magenta}};
    --rice-cyan:    #{{cyan}};
}
