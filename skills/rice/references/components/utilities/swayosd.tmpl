/* Generated by hypr-rice — re-rendered on every `rice apply`.
 * Themes the swayosd-server OSD window (volume + brightness). swayosd reads
 * ~/.config/swayosd/style.css at server startup; there's no live IPC, so
 * applying a new palette takes effect on the next server restart (the
 * manifest line's reload-cmd is empty by design — see components/utilities/
 * template.md).
 *
 * Variable map (substituted from palette.conf at render time):
 *   {{bg}}, {{surface}}, {{fg}}, {{accent}}  → bare hex (no '#').
 */

window {
    background-color: rgba(0, 0, 0, 0);
}

#osd {
    background-color: #{{bg}};
    border: 1px solid #{{surface}};
    border-radius: 16px;
    padding: 14px 18px;
    min-width: 240px;
}

#osd label {
    color: #{{fg}};
}

#osd image {
    color: #{{accent}};
    min-width: 28px;
    min-height: 28px;
}

#osd progressbar {
    background-color: #{{surface}};
    border: none;
    border-radius: 999px;
    min-height: 6px;
}

#osd progressbar > trough {
    background-color: #{{surface}};
    border-radius: 999px;
}

#osd progressbar > trough > progress {
    background-color: #{{accent}};
    border-radius: 999px;
    min-height: 6px;
}
