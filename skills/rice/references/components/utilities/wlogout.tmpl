/* Generated by hypr-rice — renders to ~/.config/wlogout/colors.css.
 * The user's ~/.config/wlogout/style.css must @import this file at the top:
 *     @import "colors.css";
 * The four var names match the wlogout row in _shared/colors-contract.md:
 *   bg fg accent surface  (CSS @define-color, leading-# hex form)
 * The corpus (JaKooLit/Hyprland-Dots, binnewbs/arch-hyprland) routinely
 * @imports waybar's colors.css instead of a wlogout-specific one — the
 * engine writes a wlogout-local colors.css so users who run a shell
 * (HyprPanel/AGS/Quickshell) without waybar still get themed wlogout.
 */
@define-color bg      #{{bg}};
@define-color fg      #{{fg}};
@define-color accent  #{{accent}};
@define-color surface #{{surface}};
