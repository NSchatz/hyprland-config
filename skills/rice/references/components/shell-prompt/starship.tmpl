# Generated by hypr-rice — a complete, palette-driven starship config.
# Rendered to ~/.config/hypr-rice/starship.toml; point starship at it with
#   set -gx STARSHIP_CONFIG ~/.config/hypr-rice/starship.toml   (fish)
#   export STARSHIP_CONFIG="$HOME/.config/hypr-rice/starship.toml" (bash/zsh)
# so `rice apply` re-themes the prompt without touching your own ~/.config/starship.toml.
# To recolor a prompt you've already designed instead, copy just the [palettes.rice] block
# below into your own starship.toml and set `palette = "rice"` at the top.

"$schema" = 'https://starship.rs/config-schema.json'

add_newline = true
palette = "rice"

format = """
$directory\
$git_branch\
$git_status\
$cmd_duration\
$line_break\
$character"""

[palettes.rice]
bg = "#{{bg}}"
fg = "#{{fg}}"
surface = "#{{surface}}"
muted = "#{{muted}}"
accent = "#{{accent}}"
accent2 = "#{{accent2}}"
red = "#{{red}}"
green = "#{{green}}"
yellow = "#{{yellow}}"
blue = "#{{blue}}"
magenta = "#{{magenta}}"
cyan = "#{{cyan}}"

[directory]
style = "fg:accent bold"
format = "[ $path ]($style)[$read_only]($read_only_style)"
truncation_length = 3
truncate_to_repo = true

[git_branch]
symbol = " "
style = "fg:green"
format = "[$symbol$branch ]($style)"

[git_status]
style = "fg:yellow"
format = "[$all_status$ahead_behind ]($style)"

[cmd_duration]
min_time = 2000
style = "fg:muted"
format = "[ $duration ]($style)"

[character]
success_symbol = "[❯](fg:accent)"
error_symbol = "[❯](fg:red)"
vimcmd_symbol = "[❮](fg:green)"
