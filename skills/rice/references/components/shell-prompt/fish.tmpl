# Generated by hypr-rice — fish syntax-highlighting & pager colors from the rice palette.
# Rendered to ~/.config/fish/conf.d/zz-hypr-rice-colors.fish, which fish auto-sources on every
# interactive start, so a `rice apply` re-themes fish on the next shell (no `fish_config theme`
# needed). Uses `set -g` (per-session global) rather than `set -U` so re-rendering this file wins
# instead of getting shadowed by a stale value baked into the universal-variable store.
# fish accepts bare hex (no '#'); --background= sets the highlight behind selections/matches.

# Syntax highlighting
set -g fish_color_normal          {{fg}}
set -g fish_color_command         {{accent}}
set -g fish_color_keyword         {{magenta}}
set -g fish_color_quote           {{green}}
set -g fish_color_redirection     {{cyan}}
set -g fish_color_end             {{yellow}}
set -g fish_color_error           {{red}}
set -g fish_color_param           {{fg}}
set -g fish_color_option          {{fg}}
set -g fish_color_valid_path      --underline
set -g fish_color_comment         {{muted}}
set -g fish_color_operator        {{cyan}}
set -g fish_color_escape          {{magenta}}
set -g fish_color_autosuggestion  {{muted}}
set -g fish_color_selection       {{fg}} --background={{surface}}
set -g fish_color_search_match    --background={{surface}}
set -g fish_color_history_current --bold

# Prompt-component colors (used by fish's default prompt and many custom ones)
set -g fish_color_cwd             {{yellow}}
set -g fish_color_cwd_root        {{red}}
set -g fish_color_user            {{green}}
set -g fish_color_host            {{accent}}
set -g fish_color_host_remote     {{yellow}}
set -g fish_color_status          {{red}}
set -g fish_color_cancel          {{red}}

# Completion pager
set -g fish_pager_color_progress             {{muted}}
set -g fish_pager_color_prefix               {{accent}} --bold
set -g fish_pager_color_completion           {{fg}}
set -g fish_pager_color_description          {{muted}}
set -g fish_pager_color_selected_background  --background={{surface}}
set -g fish_pager_color_selected_prefix      {{accent}}
set -g fish_pager_color_selected_completion  {{fg}}
