# Generated by hypr-rice — re-rendered on every `rice apply`.
# hyprlock is a separate daemon and CAN'T read Hyprland $vars from colors.conf,
# so every color here is LITERAL hex substituted from palette.conf at render time.
# See components/lock-screen/template.md for the full design and the substitution
# map; the source of truth for the layout selections is answers.json.
#
# The wallpaper path references the stable symlink maintained by
# scripts/set-wallpaper.sh — re-theme / re-pick changes one symlink, hyprlock
# follows it on the next lock without a re-render. See _shared/wallpaper-pointer.md.

$font = {{font_ui_family}}

general {
    hide_cursor = true
    ignore_empty_input = true
}

# ---------- background ----------
background {
    monitor =
    path = ~/.config/hypr-rice/current-wallpaper
    blur_passes = 1
    blur_size = 5
}

# ---------- input-field (accent-outlined default) ----------
input-field {
    monitor =
    size = 280, 55
    rounding = -1
    outline_thickness = 2
    dots_size = 0.33
    dots_spacing = 0.2
    dots_center = true
    fade_on_empty = false
    outer_color = rgb({{accent}})
    inner_color = rgb({{surface}})
    font_color  = rgb({{fg}})
    check_color = rgb({{green}})
    fail_color  = rgb({{red}})
    placeholder_text = <i>Password…</i>
    font_family = $font
    position = 0, -120
    halign = center
    valign = center
}

# ---------- clock (large default) ----------
label {
    monitor =
    text = $TIME
    font_size = 96
    font_family = $font
    color = rgb({{fg}})
    position = 0, 160
    halign = center
    valign = center
}
label {
    monitor =
    text = cmd[update:60000] date +"%A, %d %B"
    font_size = 22
    font_family = $font
    color = rgb({{fg}})
    position = 0, 90
    halign = center
    valign = center
}
