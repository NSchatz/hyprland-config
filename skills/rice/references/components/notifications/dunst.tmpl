# Generated by hypr-rice — colors for ~/.config/dunst/dunstrc.
# The writer merges these blocks into the user's dunstrc — dunst has no @import.
# Wrap format: quoted `"#RRGGBB"` per dunst(5). Per-urgency sections override
# [global]. See _shared/colors-contract.md.
#
# `highlight` is dunst 1.9+ — colors the progress_bar fill (volume/brightness OSD).
[global]
    frame_color = "#{{accent}}"
    separator_color = frame
    highlight = "#{{accent}}"

[urgency_low]
    background = "#{{bg}}"
    foreground = "#{{muted}}"
    frame_color = "#{{surface}}"

[urgency_normal]
    background = "#{{bg}}"
    foreground = "#{{fg}}"
    frame_color = "#{{accent}}"

[urgency_critical]
    background = "#{{bg}}"
    foreground = "#{{fg}}"
    frame_color = "#{{red}}"
