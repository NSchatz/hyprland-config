# Generated by hypr-rice — colors section of ~/.config/mako/config.
# mako(5) urgency criteria values are low|normal|critical — there is no "high".
# Wrap format: INI key=#RRGGBB[AA]. Background uses 8-digit hex for translucency
# (mako has no separate transparency= key). See _shared/colors-contract.md.
background-color=#{{surface}}ee
text-color=#{{fg}}
border-color=#{{accent}}
progress-color=over #{{accent}}44

[urgency=low]
border-color=#{{muted}}

[urgency=critical]
border-color=#{{red}}
