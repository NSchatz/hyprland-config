// Generated by hypr-rice — a Quickshell theme singleton. Place at ~/.config/quickshell/<name>/Colors.qml
// and register it in qmldir (`singleton Colors Colors.qml`). Quickshell hot-reloads on save, so
// re-rendering this file repaints the whole shell — no reload command. Reference everywhere as
// `Colors.accent`, `Colors.bg`, etc. instead of literal hex.
//
// Why `Singleton` from Quickshell (not `QtObject`): Quickshell's QML overview is explicit — "to
// ensure it behaves correctly with Quickshell, you should also make the Singleton the root item
// of your type." The Quickshell core warns at runtime: "Tried to register singleton which is not
// the root component of its file" when the root isn't `Singleton`. Verified across the modern
// shell corpus — caelestia (`services/Colours.qml`), end-4/dots-hyprland
// (`modules/common/Appearance.qml`), DankMaterialShell (`Common/Theme.qml`), noctalia-shell
// (`Commons/Color.qml`) all use `Singleton`. `pragma ComponentBehavior: Bound` is the standard
// companion pragma in those configs.
pragma Singleton
pragma ComponentBehavior: Bound

import QtQuick
import Quickshell

Singleton {
    id: root

    readonly property color bg:      "#{{bg}}"
    readonly property color fg:      "#{{fg}}"
    readonly property color surface: "#{{surface}}"
    readonly property color muted:   "#{{muted}}"
    readonly property color cursor:  "#{{cursor}}"
    readonly property color accent:  "#{{accent}}"
    readonly property color accent2: "#{{accent2}}"
    readonly property color red:     "#{{red}}"
    readonly property color green:   "#{{green}}"
    readonly property color yellow:  "#{{yellow}}"
    readonly property color blue:    "#{{blue}}"
    readonly property color magenta: "#{{magenta}}"
    readonly property color cyan:    "#{{cyan}}"

    // ANSI 16. Individual `term0..term15` properties match the community pattern (caelestia
    // `services/Colours.qml` lines 246-261; end-4 `modules/common/Appearance.qml` lines 93-108) —
    // sibling QML references `Colors.term3` directly. A `var term: [16]` array would force
    // `Colors.term[3]` and break drop-in copies from the corpus.
    readonly property color term0:  "#{{color0}}"
    readonly property color term1:  "#{{color1}}"
    readonly property color term2:  "#{{color2}}"
    readonly property color term3:  "#{{color3}}"
    readonly property color term4:  "#{{color4}}"
    readonly property color term5:  "#{{color5}}"
    readonly property color term6:  "#{{color6}}"
    readonly property color term7:  "#{{color7}}"
    readonly property color term8:  "#{{color8}}"
    readonly property color term9:  "#{{color9}}"
    readonly property color term10: "#{{color10}}"
    readonly property color term11: "#{{color11}}"
    readonly property color term12: "#{{color12}}"
    readonly property color term13: "#{{color13}}"
    readonly property color term14: "#{{color14}}"
    readonly property color term15: "#{{color15}}"

    // Fonts: the rice skill sets fontUi/fontMono to the bare family (font_ui/font_mono in
    // palette.conf carry a trailing size that Qt's font.family must not include).
    readonly property string fontUi:   "Inter"
    readonly property string fontMono: "JetBrainsMono Nerd Font"

    readonly property int    radius:       16
    readonly property int    animDuration: 200

    // Material 3 motion tokens — the cross-shell vocabulary the modern Quickshell rices share.
    // end-4 `Appearance.qml` (lines 251-268), DankMaterialShell `Common/Anims.qml`, caelestia
    // `components/Anim.qml` all hoist the same standard/emphasized/expressive curves into a
    // singleton so every `Behavior on … { NumberAnimation { easing.bezierCurve: … } }` shares one
    // identity. Bezier control points come from the M3 spec.
    readonly property var standard:        [0.20, 0.00, 0.00, 1.00, 1.00, 1.00]
    readonly property var standardAccel:   [0.30, 0.00, 1.00, 1.00, 1.00, 1.00]
    readonly property var standardDecel:   [0.00, 0.00, 0.00, 1.00, 1.00, 1.00]
    readonly property var emphasized:      [0.05, 0.00, 2/15, 0.06, 1/6, 0.40, 5/24, 0.82, 0.25, 1.00, 1.00, 1.00]
    readonly property var emphasizedAccel: [0.30, 0.00, 0.80, 0.15, 1.00, 1.00]
    readonly property var emphasizedDecel: [0.05, 0.70, 0.10, 1.00, 1.00, 1.00]
}
