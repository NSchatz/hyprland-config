/* Generated by hypr-rice — ~/.config/gtk-3.0/gtk.css.
 *
 * Parallel to theming/gtk4.tmpl: GTK4 / libadwaita uses semantic `@define-color
 * accent_color / window_bg_color / …` aliases; GTK3 has its own (older) set —
 * `theme_selected_bg_color`, `theme_selected_fg_color`, `theme_bg_color`,
 * `theme_fg_color`, `theme_base_color`, `theme_text_color` — plus a *:selected
 * direct override to defeat the default GTK3 (Adwaita) accent that otherwise
 * shows through on Thunar's selected-row highlight, nm-connection-editor's
 * focused entry, and any GTK3 file picker.
 *
 * The rice already manages dark base + icon-theme via settings.ini /
 * gsettings (see ../look-feel/template.md `gtk3-settings` block); this file
 * is the accent layer the dark base doesn't provide.
 */

@define-color theme_selected_bg_color #{{accent}};
@define-color theme_selected_fg_color #{{bg}};

@define-color theme_bg_color #{{bg}};
@define-color theme_fg_color #{{fg}};
@define-color theme_base_color #{{bg}};
@define-color theme_text_color #{{fg}};

@define-color theme_button_background_normal #{{surface}};
@define-color theme_button_foreground_normal #{{fg}};

@define-color insensitive_bg_color #{{surface}};
@define-color insensitive_fg_color #{{muted}};

@define-color borders #{{surface}};
@define-color warning_color #{{yellow}};
@define-color error_color #{{red}};
@define-color success_color #{{green}};

/* Defeat the inherited Adwaita accent on :selected — without this row the
 * file-manager selection bar reads as blue/orange even when
 * theme_selected_bg_color is set, because Adwaita's selection rule has higher
 * CSS specificity than our @define-color aliases. */
*:selected,
*:selected:focus,
*:selected:focus:hover,
.view:selected,
.view:selected:focus {
    background-color: #{{accent}};
    color: #{{bg}};
}

/* Header bars on classic GTK3 apps (Thunar 4.18-, Nautilus on GTK3 builds). */
headerbar,
.titlebar {
    background-color: #{{surface}};
    color: #{{fg}};
}

/* Entry focus ring matches accent so Nm-connection-editor / Thunar's path bar
 * focuses with rice accent, not stock Adwaita blue. */
entry:focus {
    border-color: #{{accent}};
}

tooltip {
    background-color: #{{bg}};
    color: #{{fg}};
    border: 1px solid #{{surface}};
}
