# Generated by hypr-rice — save as ~/.config/btop/themes/rice.theme and set
# color_theme = "rice" in ~/.config/btop/btop.conf (takes effect on btop restart).
#
# Key set verified against upstream btop themes (`aristocratos/btop/main/themes/*.theme`):
# main_bg, main_fg, title, hi_fg, selected_bg, selected_fg, inactive_fg, graph_text,
# meter_bg, proc_misc, cpu_box, mem_box, net_box, proc_box, div_line,
# temp_{start,mid,end}, cpu_{start,mid,end},
# free_{start,mid,end}, cached_{start,mid,end}, available_{start,mid,end},
# used_{start,mid,end}, download_{start,mid,end}, upload_{start,mid,end},
# process_{start,mid,end}.
# Leaving the optional `*_mid` of a 2-stop gradient empty (`""`) is documented and is
# how upstream themes do single-color->endpoint fades (see Dracula, Default themes).
theme[main_bg]="#{{bg}}"
theme[main_fg]="#{{fg}}"
theme[title]="#{{fg}}"
theme[hi_fg]="#{{accent}}"
theme[selected_bg]="#{{surface}}"
theme[selected_fg]="#{{accent}}"
theme[inactive_fg]="#{{muted}}"
theme[graph_text]="#{{fg}}"
theme[meter_bg]="#{{surface}}"
theme[proc_misc]="#{{accent2}}"

# Box outlines — community convention is to tint each box its dominant signal hue
# (HyDE, ML4W matugen btop.theme both follow this).
theme[cpu_box]="#{{accent}}"
theme[mem_box]="#{{green}}"
theme[net_box]="#{{magenta}}"
theme[proc_box]="#{{blue}}"
theme[div_line]="#{{surface}}"

# Temperature gradient: cold → hot.
theme[temp_start]="#{{green}}"
theme[temp_mid]="#{{yellow}}"
theme[temp_end]="#{{red}}"

# CPU load gradient: idle → maxed.
theme[cpu_start]="#{{green}}"
theme[cpu_mid]="#{{yellow}}"
theme[cpu_end]="#{{red}}"

# Memory free meter.
theme[free_start]="#{{blue}}"
theme[free_mid]="#{{cyan}}"
theme[free_end]="#{{green}}"

# Memory cached meter — upstream themes typically reuse the cyan/blue axis.
theme[cached_start]="#{{cyan}}"
theme[cached_mid]=""
theme[cached_end]="#{{blue}}"

# Memory available meter — accent gradient (matches ML4W's primary→primary_container).
theme[available_start]="#{{accent}}"
theme[available_mid]=""
theme[available_end]="#{{accent2}}"

# Memory used meter: green → yellow → red (matches the cpu_* gradient).
theme[used_start]="#{{green}}"
theme[used_mid]="#{{yellow}}"
theme[used_end]="#{{red}}"

# Network download gradient.
theme[download_start]="#{{blue}}"
theme[download_mid]="#{{cyan}}"
theme[download_end]="#{{green}}"

# Network upload gradient.
theme[upload_start]="#{{magenta}}"
theme[upload_mid]="#{{red}}"
theme[upload_end]="#{{yellow}}"

# Processes meter (per-process CPU bar).
theme[process_start]="#{{green}}"
theme[process_mid]="#{{yellow}}"
theme[process_end]="#{{red}}"
