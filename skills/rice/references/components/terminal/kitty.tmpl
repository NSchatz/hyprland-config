# Generated by hypr-rice — `include colors.conf` from kitty.conf.
#
# Layout matches the community standard:
#   - core: background / foreground / cursor / selection (mirrors catppuccin/kitty mocha.conf).
#   - cursor_text_color: contrast color drawn ON TOP of the cursor (catppuccin sets this
#     to #1E1E2E = bg). Without it kitty falls back to background, which looks fine for
#     beam cursors but reads as invisible for block cursors over the accent.
#   - url_color: the underline color when hovering a URL with the mouse — community
#     defaults to accent (catppuccin uses lavender, HyDE uses a wallbash primary).
#   - active_tab_*/inactive_tab_*/tab_bar_background: the powerline tab bar needs all
#     six keys to render coherently (see catppuccin/kitty, HyDE Wall-Dcol/kitty.dcol,
#     DankMaterialShell/kitty-tabs.conf). Skipping them leaves the tab strip on
#     kitty's hardcoded #444/#888 defaults, which always clashes with a riced palette.
#   - active_border_color/inactive_border_color/bell_border_color: visible only when
#     kitty draws its own window border (window_border_width >= 1pt). HyDE and
#     catppuccin both export them; harmless when borders are off.
background              #{{bg}}
foreground              #{{fg}}
cursor                  #{{cursor}}
cursor_text_color       #{{bg}}
selection_background    #{{accent}}
selection_foreground    #{{bg}}
url_color               #{{accent}}

# Tab bar — paired with `tab_bar_style powerline` in the recipe.
active_tab_foreground   #{{bg}}
active_tab_background   #{{accent}}
inactive_tab_foreground #{{muted}}
inactive_tab_background #{{surface}}
tab_bar_background      #{{bg}}

# Window borders — only rendered when window_border_width > 0.
active_border_color     #{{accent}}
inactive_border_color   #{{surface}}
bell_border_color       #{{red}}

# 16-color ANSI palette — the dominant signal of the theme.
color0  #{{color0}}
color1  #{{color1}}
color2  #{{color2}}
color3  #{{color3}}
color4  #{{color4}}
color5  #{{color5}}
color6  #{{color6}}
color7  #{{color7}}
color8  #{{color8}}
color9  #{{color9}}
color10 #{{color10}}
color11 #{{color11}}
color12 #{{color12}}
color13 #{{color13}}
color14 #{{color14}}
color15 #{{color15}}
