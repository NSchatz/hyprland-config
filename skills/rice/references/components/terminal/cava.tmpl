# Generated by hypr-rice — merge the [color] section into ~/.config/cava/config (restart cava).
#
# Cava supports up to 8 gradient stops. Both HyDE (Configs/.config/hyde/wallbash/
# Wall-Ways/cava.dcol) and JaKooLit (config/wallust/templates/colors-cava) use ALL
# 8 stops — leaving stops empty falls back to a hardcoded green->red default that
# clashes with a riced palette. Stops MUST be in ascending order from bottom of bar
# (gradient_color_1) to top (gradient_color_8).
#
# The mapping below traverses the ANSI palette monotonically (blue → cyan → green
# → yellow → magenta → red with accent endpoints), matching the JaKooLit shape
# (color0/2/3/5/7/12/13/15). Set `gradient_count = 8` if you also set the count.
[color]
gradient = 1
gradient_count = 8
gradient_color_1 = '#{{blue}}'
gradient_color_2 = '#{{cyan}}'
gradient_color_3 = '#{{green}}'
gradient_color_4 = '#{{yellow}}'
gradient_color_5 = '#{{accent2}}'
gradient_color_6 = '#{{magenta}}'
gradient_color_7 = '#{{red}}'
gradient_color_8 = '#{{accent}}'
foreground = '#{{accent}}'
background = '#{{bg}}'
