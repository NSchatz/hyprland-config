# Generated by hypr-rice — colors for ~/.config/dunst/dunstrc (merge into [urgency_*]).
[global]
    frame_color = "#{{accent}}"
    separator_color = "#{{surface}}"

[urgency_low]
    background = "#{{bg}}"
    foreground = "#{{muted}}"
    frame_color = "#{{surface}}"

[urgency_normal]
    background = "#{{bg}}"
    foreground = "#{{fg}}"
    frame_color = "#{{accent}}"

[urgency_critical]
    background = "#{{bg}}"
    foreground = "#{{fg}}"
    frame_color = "#{{red}}"
