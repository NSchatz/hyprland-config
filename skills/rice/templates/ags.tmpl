// Generated by hypr-rice — @use "colors" as *; (or @import) from your AGS/Astal style.scss.
// Works under both sassc (AGS v1) and dart-sass (Astal/v2). Reference the vars; the shell's
// file-monitor recompiles + resetCss/applyCss on change. Map the semantic aliases to taste.
$bg:      #{{bg}};
$fg:      #{{fg}};
$surface: #{{surface}};
$muted:   #{{muted}};
$cursor:  #{{cursor}};
$accent:  #{{accent}};
$accent2: #{{accent2}};
$red:     #{{red}};
$green:   #{{green}};
$yellow:  #{{yellow}};
$blue:    #{{blue}};
$magenta: #{{magenta}};
$cyan:    #{{cyan}};
$color0:  #{{color0}};
$color1:  #{{color1}};
$color2:  #{{color2}};
$color3:  #{{color3}};
$color4:  #{{color4}};
$color5:  #{{color5}};
$color6:  #{{color6}};
$color7:  #{{color7}};
$color8:  #{{color8}};
$color9:  #{{color9}};
$color10: #{{color10}};
$color11: #{{color11}};
$color12: #{{color12}};
$color13: #{{color13}};
$color14: #{{color14}};
$color15: #{{color15}};
// Fonts are set in style.scss directly (the rice skill writes the family from font_ui/font_mono,
// without the size that palette.conf stores) — colors only here, like every rice template.

// Semantic aliases the components reference (so a re-theme touches only this file).
$window-bg:    $bg;
$on-window:    $fg;
$card-bg:      $surface;
$primary:      $accent;
$secondary:    $accent2;
$radius:       16px;
$anim-duration: 200ms;

// GTK-CSS interop: if a host GTK app / GTK4 widget consumes @define-color, these mirror the vars.
@define-color bg #{{bg}};
@define-color fg #{{fg}};
@define-color surface #{{surface}};
@define-color accent #{{accent}};
@define-color accent2 #{{accent2}};
