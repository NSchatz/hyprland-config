# Authoring-environment state (which dev plugins are enabled while building) — not part of the plugin
.claude/

# Plugin-local settings
.claude/*.local.md

# Generation staging / test output
/tmp/hypr-gen-*
hypr-test/
*.bak.*

# Visual test screenshots — produced fresh on every run, uploaded as a CI artifact
tests/visual/output/

# Agent-eval per-run logs (verdicts, diffs, prior snapshots) — not committed; only the
# generated/<fixture>/ baselines under tests/agent-eval/generated/ are.
tests/agent-eval/output/
